APP_NAME="Nexo Events"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nexo_events
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production (HTTPS) set these to harden the session cookie:
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local Docker runtime (compose.yaml serves the app only — MySQL and Mailpit are
# external; see AGENTS.md "How to run it"). WWWUSER/WWWGROUP match the host user
# so files written inside the container stay writable outside it.
APP_PORT=8103
VITE_PORT=5178
WWWUSER=1000
WWWGROUP=1000

# Nexo ecosystem (shared chrome). Identifies this tool in the app-switcher and
# footer; self-hosters can point the hub/tool/attribution URLs at their own
# instances. Leave NEXO_ECOSYSTEM_CURRENT empty for a standalone self-host with
# no ecosystem identity.
NEXO_ECOSYSTEM_CURRENT=nexoevents
# NEXO_HUB_URL=https://nexotools.alvarocdev.com
# NEXO_GITHUB_ORG=https://github.com/nexo-tools

# Canonical "powered by" attribution shown in the footer (both are read by the
# shared footer; the label falls back to alvarocdev.com when unset).
NEXO_ATTRIBUTION_LABEL=alvarocdev.com
NEXO_ATTRIBUTION_URL=https://alvarocdev.com

# Help center contact. A support URL (e.g. a form) wins; otherwise the help page
# links a mailto: to NEXO_SUPPORT_EMAIL.
NEXO_SUPPORT_EMAIL=hola@alvarocdev.com
# NEXO_SUPPORT_URL=

# Nexo ID SSO (optional). Off by default: the app runs standalone with local
# organizer accounts. Enable to add "Continuar con Nexo ID" to the login screen
# (OIDC + PKCE). Only organizers ever sign in — attendees register with an email
# and no account (ADR-003), so SSO never touches the attendee flow. Register the
# client on the provider with an exact redirect of {APP_URL}/auth/nexo/callback
# (php artisan nexo:sso-client).
NEXO_SSO_ENABLED=false
NEXO_SSO_ISSUER=https://nexoid.alvarocdev.com
NEXO_SSO_CLIENT_ID=
# Silent SSO (OIDC prompt=none). With SSO on, an organizer who already has a live
# Nexo ID session is signed in automatically — no click, no login screen — which is
# what makes the session feel shared across Nexo tools. Without such a session the
# attempt is invisible and happens at most once per session (no redirect loops).
# Set to false to keep SSO but require the explicit button. Public event pages and
# attendee tickets are always excluded from it (see config/nexo-sso.php).
NEXO_SSO_SILENT=true
# Where Nexo ID sends the browser after a central logout. Must ALSO be registered
# as a redirect URI of this client on the provider, or it is refused.
# NEXO_SSO_POST_LOGOUT_REDIRECT_URI=

# Cookieless beacon (ecosystem analytics). OFF by default: a self-hosted
# instance must never phone home unasked. Respects Do Not Track, sends no PII.
NEXO_BEACON_ENABLED=false
# NEXO_BEACON_ENDPOINT=https://nexotools.alvarocdev.com/beacon
