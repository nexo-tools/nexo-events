APP_NAME="Nexo Events"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Events are compared against now() by the door guard, so this must match the
# clock your organizers think in — not the server's.
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
# Source strings are English now, so a key missing from lang/es.json renders
# readable English instead of the raw key.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. The values below target the shared local Docker stack `nexo`
# (MySQL on host port 3307); this repo's compose.yaml only runs the app runtime,
# so the database is reached through host.docker.internal.
# SELF-HOSTING: point these at your own MySQL — see DEPLOYMENT.md.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=nexo_events
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
# The session payload carries the OIDC id_token used for RP-initiated logout
# (NexoSsoController), so it is encrypted at rest: with the database driver the
# raw token would otherwise sit readable in the sessions table (2026-08-02).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# In production (HTTPS) set these to harden the session cookie:
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local Docker runtime (compose.yaml serves the app only — MySQL and Mailpit are
# external; see AGENTS.md "How to run it"). WWWUSER/WWWGROUP match the host user
# so files written inside the container stay writable outside it.
APP_PORT=8103
VITE_PORT=5178
WWWUSER=1000
WWWGROUP=1000

# Nexo ecosystem (shared chrome). Identifies this tool in the app-switcher and
# footer; self-hosters can point the hub/tool/attribution URLs at their own
# instances. Leave NEXO_ECOSYSTEM_CURRENT empty for a standalone self-host with
# no ecosystem identity.
NEXO_ECOSYSTEM_CURRENT=nexoevents
# NEXO_HUB_URL=https://nexotools.alvarocdev.com
# NEXO_GITHUB_ORG=https://github.com/nexo-tools

# Canonical "powered by" attribution shown in the footer (both are read by the
# shared footer; the label falls back to alvarocdev.com when unset).
# Attribution shown in the footer. Leave unset and the tool shows its own
# neutral default ("made with Nexo Events"). A third-party instance must NOT advertise
# the upstream author; set your own here.
# NEXO_ATTRIBUTION_LABEL="powered by yoursite.com"
# NEXO_ATTRIBUTION_URL="https://yoursite.com"

# Help center contact. A support URL (e.g. a form) wins; otherwise the help page
# links a mailto: to NEXO_SUPPORT_EMAIL.
NEXO_SUPPORT_EMAIL=hola@alvarocdev.com
# Mail al operador cuando algo revienta (dedupe 15 min por excepción). Un job en
# cola avisa solo cuando se rinde (último intento), nunca en un intento que se reintenta.
NEXO_OPS_MAIL=false
# NEXO_SUPPORT_URL=

# Nexo ID SSO (optional). Off by default: the app runs standalone with local
# organizer accounts. Enable to add "Continuar con Nexo ID" to the login screen
# (OIDC + PKCE). Only organizers ever sign in — attendees register with an email
# and no account (ADR-003), so SSO never touches the attendee flow. Register the
# client on the provider with an exact redirect of {APP_URL}/auth/nexo/callback
# (php artisan nexo:sso-client).
NEXO_SSO_ENABLED=false
NEXO_SSO_ISSUER=https://nexoid.alvarocdev.com
NEXO_SSO_CLIENT_ID=
# Silent SSO (OIDC prompt=none). With SSO on, an organizer who already has a live
# Nexo ID session is signed in automatically — no click, no login screen — which is
# what makes the session feel shared across Nexo tools. Without such a session the
# attempt is invisible and happens at most once per session (no redirect loops).
# Set to false to keep SSO but require the explicit button. Public event pages and
# attendee tickets are always excluded from it (see config/nexo-sso.php).
NEXO_SSO_SILENT=true
NEXO_SSO_TIMEOUT=5
# Where Nexo ID sends the browser after a central logout. Empty = this tool's
# own «Cerraste sesión en todo Nexo» screen, {APP_URL}/auth/nexo/signed-out. It
# must ALSO be registered as a redirect URI of this client on the provider
# (php artisan nexo:sso-client:update <client_id> --add-redirect=…), or it is
# refused.
NEXO_SSO_POST_LOGOUT_REDIRECT_URI=
# Nexo ID controls the session (nexo-sso-client v2). Back-channel logout: Nexo ID
# tells this tool, server to server, which session ended
# (POST {APP_URL}/auth/nexo/backchannel-logout; register it with
# nexo:sso-client:update --backchannel=…). false = that endpoint answers 501.
NEXO_SSO_BACKCHANNEL=true
# Every N minutes an SSO session re-checks with Nexo ID (prompt=none) on its
# next page load — never on a form POST or a JSON call, so the door scanner's
# check-ins are never bounced. 0 = off. If Nexo ID is down nobody is signed out.
NEXO_SSO_RECHECK_MINUTES=15
# Who may sign in with what (only with NEXO_SSO_ENABLED=true; off = always local):
#   local       email + password and local sign-up (self-host default), plus
#               «Continuar con Nexo ID»
#   transition  Nexo ID first; passwords only for accounts not linked yet, until
#               NEXO_AUTH_TRANSITION_UNTIL (YYYY-MM-DD, last day); then as sso
#   sso         only Nexo ID: local login, sign-up and password reset answer 404
NEXO_AUTH_MODE=local
NEXO_AUTH_TRANSITION_UNTIL=

# Integration API v1 (optional). OFF by default: with this false the /api/v1
# routes answer 404 and the organizer panel shows no trace of them, so a
# standalone instance behaves exactly as it did before the API existed. Turn it
# on to let an organizer link an external site to their account with a scoped,
# revocable token issued at /app/integraciones. No attendee data is ever
# reachable through it. Limits are per token, per minute.
NEXO_API_ENABLED=false
# NEXO_API_RATE_READ=60
# NEXO_API_RATE_WRITE=20

# Optional "WhatsApp or phone" field when an attendee registers. off (default) =
# registration asks only name and email, and a phone posted anyway is ignored.
# optional = the field appears, never required. Only the event owner sees the
# number (registrations list); never collaborators, emails, public pages or
# the integration API. The privacy page mentions it only while it is on.
NEXO_ATTENDEE_PHONE=off
# The country the phone's selector starts on (ISO code). A number typed without
# "+" is read as one of this country's; people elsewhere pick theirs.
NEXO_ATTENDEE_PHONE_COUNTRY=AR

# Cookieless beacon (ecosystem analytics). OFF by default: a self-hosted
# instance must never phone home unasked. Respects Do Not Track, sends no PII.
NEXO_BEACON_ENABLED=false
# NEXO_BEACON_ENDPOINT=https://nexotools.alvarocdev.com/beacon

# Who runs this instance, named on the legal pages. Unset (default) = the
# "who runs this instance" section is not rendered, so a clone never publishes
# the upstream author's details. Alvaro's instances get these from CI.
# NEXO_LEGAL_OPERATOR="Your name or company"
# NEXO_LEGAL_CONTACT=legal@yourdomain.com
